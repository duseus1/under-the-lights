{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Under the Lights",
  "version": "1.0.0",
  "identifier": "com.underthelights.career",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Under the Lights",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 700,
        "backgroundColor": "#10151b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Your game. Your career. Your story.",
    "category": "Sports",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
